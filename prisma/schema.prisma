generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

// LOCAL DEV: keep provider = "sqlite", DATABASE_URL = "file:./dev.db"
// VERCEL:    change provider to "postgresql", DATABASE_URL = postgresql://...
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  password  String
  email     String?  @unique
  avatar    String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills             Bill[]
  presets           PricePreset[]
  subscription      Subscription?
  proRequests       ProRequest[]
  rooms             Room[]
  notifications     UserNotification[]
}

model Room {
  id        Int        @id @default(autoincrement())
  userId    Int
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  price     Float
  area      Float?
  type      String
  status    String     @default("Available")
  isDeleted Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  contracts      Contract[]
  medias         RoomMedia[]
  utilityRecords UtilityRecord[]
  invoices       Invoice[]

  @@unique([userId, name])
}

model RoomMedia {
  id        Int      @id @default(autoincrement())
  roomId    Int
  room      Room     @relation(fields: [roomId], references: [id])
  url       String
  type      String
  createdAt DateTime @default(now())
}

model Tenant {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String?
  email        String?
  identityCard String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contracts Contract[]
}

model Contract {
  id            Int      @id @default(autoincrement())
  roomId        Int
  tenantId      Int
  startDate     DateTime
  endDate       DateTime
  depositAmount Float?
  tenantCount   Int      @default(1)
  isActive      Boolean  @default(true)
  tenantList    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  room   Room   @relation(fields: [roomId], references: [id], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

model UtilityRecord {
  id             Int      @id @default(autoincrement())
  roomId         Int
  recordMonth    String
  electricityOld Int?
  electricityNew Int?
  waterOld       Int?
  waterNew       Int?
  createdAt      DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Invoice {
  id                Int      @id @default(autoincrement())
  roomId            Int
  invoiceMonth      String
  roomCharge        Float
  electricityCharge Float
  waterCharge       Float
  additionalFees    Float    @default(0)
  totalAmount       Float
  isPaid            Boolean  @default(false)
  createdAt         DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Bill {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId      String?
  roomName    String
  month       String
  total       String
  totalAmount Float    @default(0)
  paid        Boolean  @default(false)
  html        String
  dateCreated DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PricePreset {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  electricPrice Float    @default(0)
  waterPrice    Float    @default(0)
  managementFee Float    @default(0)
  internetFee   Float    @default(0)
  parkingFee    Float    @default(0)
  extraFees     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Subscription {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String
  status    String   @default("active")
  expiresAt DateTime
  autoRenew Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserNotification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  reason    String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  fromId    Int
  toId      Int
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ProRequest {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            String
  amount          Float    @default(0)
  type            String
  status          String   @default("PENDING")
  username        String?
  rejectionReason String?
  seenByUser      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
