# ============================================================
# RENTIFY — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.

# --- Server ---
PORT=3000

# --- JWT ---
JWT_SECRET=replace-with-a-strong-random-secret

# --- Database ---
# For LOCAL development: sign up at https://neon.tech (free tier)
# then paste the connection string below.
#
# For VERCEL: add this same variable in your Vercel project settings
# (Project → Settings → Environment Variables).
#
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ============================================================
# HOW TO DEPLOY ON VERCEL
# ============================================================
# 1. Create a free PostgreSQL database at https://neon.tech
# 2. Copy the connection string into DATABASE_URL above
# 3. Run: npx prisma db push   (pushes schema to your new DB)
# 4. Start the server once locally; register the FIRST user
#    — that account automatically gets the ADMIN role.
# 5. Push to GitHub, import project in Vercel, add the env vars,
#    and Vercel will run `npm run vercel-build` automatically.
# ============================================================
