generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Room {
  id        Int      @id @default(autoincrement())
  name      String   @unique // corresponds to room_number in python
  price     Float
  area      Float?
  type      String
  status    String   @default("Available") // Available, Occupied, Maintenance
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  contracts      Contract[]
  medias         RoomMedia[]
  utilityRecords UtilityRecord[]
  invoices       Invoice[]
}

model RoomMedia {
  id        Int      @id @default(autoincrement())
  roomId    Int
  room      Room     @relation(fields: [roomId], references: [id])
  url       String // Chứa đường dẫn ảnh HOẶC link video ngoài
  type      String // Thay vì Enum (SQLite không hỗ trợ Enum), dùng String: "IMAGE", "VIDEO"
  createdAt DateTime @default(now())
}

model Tenant {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String?
  email        String?  @unique
  identityCard String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contracts Contract[]
}

model Contract {
  id            Int      @id @default(autoincrement())
  roomId        Int
  tenantId      Int
  startDate     DateTime
  endDate       DateTime
  depositAmount Float?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  room   Room   @relation(fields: [roomId], references: [id], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

model UtilityRecord {
  id             Int      @id @default(autoincrement())
  roomId         Int
  recordMonth    String // e.g. "2023-10"
  electricityOld Int?
  electricityNew Int?
  waterOld       Int?
  waterNew       Int?
  createdAt      DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Invoice {
  id                Int      @id @default(autoincrement())
  roomId            Int
  invoiceMonth      String // e.g. "2023-10"
  roomCharge        Float
  electricityCharge Float
  waterCharge       Float
  additionalFees    Float    @default(0)
  totalAmount       Float
  isPaid            Boolean  @default(false)
  createdAt         DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
}
